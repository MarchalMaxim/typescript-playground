{
  "name": "typescript-playground",
  "version": "1.0.0",
  "description": "Playground for testing out typescript stuff",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/bundle.js --platform=browser --target=es2020",
    "dev": "npm run build && live-server --port=8080 --open=/index.html",
    "watch": "esbuild src/index.ts --bundle --outfile=dist/bundle.js --platform=browser --target=es2020 --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.0",
    "live-server": "^1.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/highlight": "^0.19.8",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.7",
    "codemirror": "^6.0.2"
  }
}
